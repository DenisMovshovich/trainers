# Настройки IDE — у каждого свои
.idea/
.vscode/
*.iml

# Служебное от macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Зависимости и сборочный мусор
node_modules/
*.log
*.zip

# Снимки экрана, которые делают скрипты проверки
**/src/*.png
**/src/n[0-9].png
**/src/_s[0-9].png

# Внутри src/ легитимны только пронумерованные части (10_head.html, 20_body.html).
# Всё остальное там — устаревшие копии сборки: настоящие лежат в корне материала.
**/src/*.html
!**/src/[0-9][0-9]_*.html

# Сайт собирается из исходников скриптом tools/build-site.sh и публикуется
# через GitHub Actions. В репозитории не хранится, чтобы не плодить дубликаты.
docs/

# Тренажёр по git — отдельный репозиторий со своей историей
git-trainer/
